+/// Multiplier on the value of prompt work, from FLARE_PREFILL_PRIORITY; 1.0 when unset or invalid.
+/// Above 1.0 a waiting prompt outbids decode rounds sooner, so new turns start decoding earlier.
+fn prefill_priority() -> f64 {
+    static PRIORITY: std::sync::OnceLock<f64> = std::sync::OnceLock::new();
+    *PRIORITY.get_or_init(|| {
+        std::env::var("FLARE_PREFILL_PRIORITY")
+            .ok()
+            .and_then(|value| value.parse::<f64>().ok())
+            .filter(|value| value.is_finite() && *value > 0.0)
+            .unwrap_or(1.0)
+    })
+}
